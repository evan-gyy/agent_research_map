---
import type { QuestionRecord } from "../lib/content";
import { getKnowledgePointLabel, stripHtml } from "../lib/content";

interface Props { question: QuestionRecord; frequency: number; highFrequency: boolean; }
const { question, frequency, highFrequency } = Astro.props;
const base = import.meta.env.BASE_URL;
const searchText = [question.id, question.title, question.area, getKnowledgePointLabel(question.knowledgePoint), ...question.tags, stripHtml(question.answerHtml)].join(" ").toLowerCase();
---
<article class="card question-card" data-question-card data-id={question.id} data-area={question.area} data-point={question.knowledgePoint} data-answer={question.answerHtml ? "answered" : "unanswered"} data-date={question.collectedAt} data-frequency={frequency} data-search={searchText}>
  <div class="question-card-main">
    <span class="question-id">{question.id}</span>
    <h2><a href={base + "questions/" + question.id.toLowerCase() + "/"}>{question.title}</a></h2>
  </div>
  <div class="question-card-meta">
    <span class="badge">{question.area}</span>
    {highFrequency && <span class="badge hot">高频 · {frequency}</span>}
    <span class="pill">{getKnowledgePointLabel(question.knowledgePoint)}</span>
    {question.tags.map((tag) => <span class="badge question-tag">{tag}</span>)}
    <span class:list={["note-state", { answered: Boolean(question.answerHtml) }]}>{question.answerHtml ? "有笔记" : "待补充"}</span>
    <button class="favorite-small" type="button" data-favorite-toggle aria-label={"收藏 " + question.id}>☆</button>
  </div>
</article>
