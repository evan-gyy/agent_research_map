---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  active?: "home" | "questions" | "stats";
}
const {
  title = "AI · LLM 学习库",
  description = "面向个人学习与长期积累的 AI · LLM 知识库。",
  active = "home",
} = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (path = "") => base + path.replace(/^\//, "");
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5548d9" />
    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
    <title>{title === "AI · LLM 学习库" ? title : title + " · AI · LLM 学习库"}</title>
    <script is:inline>
      const savedTheme = localStorage.getItem("ai-llm-learning-theme");
      const dark = savedTheme === "dark" || (!savedTheme && matchMedia("(prefers-color-scheme: dark)").matches);
      if (dark) document.documentElement.dataset.theme = "dark";
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={href()} aria-label="AI · LLM 学习库首页">
          <span class="brand-mark" aria-hidden="true">A</span><span>AI · LLM 学习库</span>
        </a>
        <nav class="nav" aria-label="主导航">
          <a href={href()} aria-current={active === "home" ? "page" : undefined}>总览</a>
          <a href={href("questions/")} aria-current={active === "questions" ? "page" : undefined}>题库</a>
          <a href={href("stats/")} aria-current={active === "stats" ? "page" : undefined}>统计</a>
        </nav>
        <button class="icon-button" id="theme-toggle" type="button" aria-label="切换明暗主题" title="切换明暗主题">◐</button>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span>个人学习、知识整理与长期积累 · 进度仅保存在当前浏览器</span>
        <button class="text-button" id="reset-progress" type="button">重置本机进度</button>
      </div>
    </footer>
    <script>
      const themeButton = document.querySelector<HTMLButtonElement>("#theme-toggle");
      themeButton?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("ai-llm-learning-theme", next);
      });
      document.querySelector<HTMLButtonElement>("#reset-progress")?.addEventListener("click", () => {
        if (confirm("确定清除当前浏览器中的全部学习进度和收藏吗？")) {
          localStorage.removeItem("ai-llm-learning-library:v1");
          location.reload();
        }
      });
    </script>
  </body>
</html>
